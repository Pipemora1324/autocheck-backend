# Copia este archivo a .env y reemplaza los valores. Nunca subas .env al repositorio.

# development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Origenes permitidos por CORS, separados por coma (obligatorio en produccion)
CORS_ORIGIN=http://localhost:4200

# URL publica del frontend; se usa para el enlace de restablecer contrasena (obligatoria en produccion)
APP_URL=http://localhost:4200

# Cadena de conexion DIRECTA de Neon (host sin -pooler), copiada tal cual del panel de Neon.
# Empieza por postgresql:// y termina en ?sslmode=require
DATABASE_URL=

# Secretos de firma JWT: minimo 32 caracteres y distintos entre si. Generalos con:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# SMTP para el correo de recuperacion de contrasena. Si se deja vacio en desarrollo,
# el enlace se imprime en la consola; en produccion no se envia nada.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AutoCheck-CO <no-reply@tu-dominio.com>"

# Solo para pruebas de integracion: base desechable cuyo nombre contenga "test" (se borra al correr npm test)
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/autocheck_test
