# Copia este archivo a .env y reemplaza los valores. Nunca subas .env al repositorio.
# Todas las variables se validan al arrancar; si falta o sobra algo, el error dice cual.

# development | test | production
NODE_ENV=development

# Puerto HTTP de la API
PORT=3000

# Origenes permitidos por CORS, separados por coma, sin / final ni comodines (obligatorio en produccion)
CORS_ORIGIN=http://localhost:4200

# URL publica del frontend; los correos enlazan a APP_URL/verify-email y APP_URL/reset-password (obligatoria en produccion)
APP_URL=http://localhost:4200

# Cadena de conexion DIRECTA de Neon (host sin -pooler), copiada tal cual del panel de Neon.
# Empieza por postgresql:// y termina en ?sslmode=require
DATABASE_URL=

# Secretos de firma JWT: minimo 32 caracteres y distintos entre si. Generalos con:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cookie del refresh token. En produccion detras del rewrite de Vercel: COOKIE_PATH=/api/auth y COOKIE_SAMESITE=strict.
# Por defecto: /auth y lax en desarrollo, strict en produccion. none solo se acepta en produccion.
COOKIE_PATH=/auth
COOKIE_SAMESITE=lax

# Cantidad de proxies delante de Express: 0 en local, 1 solo Render, 2 Vercel + Render (ver DEPLOY.md)
TRUST_PROXY=0

# SMTP para los correos de verificacion y de recuperacion. Si se deja vacio en desarrollo,
# los enlaces se imprimen en la consola; en produccion no se envia nada.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AutoCheck-CO <no-reply@tu-dominio.com>"

# Lectura de la tarjeta de propiedad con vision (opcional). Sin clave, POST /garage/scan-card responde 503.
# La clave se crea en https://console.anthropic.com y va solo aqui o en Render, nunca en el repositorio.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Consulta RUNT por proveedor externo: none (por defecto, solo garaje manual) o verifik.
# El adaptador verifik es un esqueleto hasta confirmar el contrato (ver DEPLOY.md).
RUNT_PROVIDER=none
VERIFIK_API_KEY=

# Solo para pruebas de integracion: base desechable cuyo nombre contenga "test" (se borra al correr npm test)
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/autocheck_test
