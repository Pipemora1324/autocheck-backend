# Copia este archivo a .env y reemplaza los valores. Nunca subas .env al repositorio.
# Todas las variables se validan al arrancar; si falta o es invalida alguna, el error dice cual.
# OBLIGATORIA = siempre; PROD = obligatoria en produccion; OPCIONAL = puede quedar vacia.

# OBLIGATORIA. development | test | production
NODE_ENV=development

# OPCIONAL. Puerto HTTP (Render lo define solo)
PORT=3000

# PROD. Origenes permitidos por CORS, separados por coma, sin / final ni comodines
CORS_ORIGIN=http://localhost:4200

# PROD. URL publica del frontend; los correos enlazan a APP_URL/verify-email y APP_URL/reset-password
APP_URL=http://localhost:4200

# OBLIGATORIA. Cadena de conexion DIRECTA de Neon (host sin -pooler), copiada tal cual del panel de Neon.
# Empieza por postgresql:// y termina en ?sslmode=require
DATABASE_URL=

# OBLIGATORIAS. Secretos JWT: minimo 32 caracteres y distintos entre si. Generalos con:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# OPCIONALES. Cookie del refresh token. En produccion detras de Vercel: /api/auth y strict.
COOKIE_PATH=/auth
COOKIE_SAMESITE=lax

# OPCIONAL. Proxies delante de Express: 0 en local, 1 solo Render, 2 Vercel + Render (ver DEPLOY.md)
TRUST_PROXY=0

# Correo de verificacion y recuperacion.
# EMAIL_PROVIDER: brevo (por defecto en produccion), smtp, o console (por defecto en desarrollo; imprime los enlaces).
EMAIL_PROVIDER=console
# PROD con brevo. Clave de la API v3 de Brevo (Settings > SMTP & API > API keys)
BREVO_API_KEY=
# PROD. Solo el correo remitente, ya verificado en Brevo. El nombre va aparte.
MAIL_FROM=
MAIL_FROM_NAME=AutoCheck-CO
# Solo con EMAIL_PROVIDER=smtp (no funciona en Render gratuito: bloquea los puertos SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# OPCIONAL. Correos que reciben rol admin al verificar su correo o iniciar sesion ya verificados, separados por coma
ADMIN_EMAILS=

# OPCIONAL. Lectura de la tarjeta de propiedad: gemini, anthropic o none. Sin la clave del elegido, scan-card responde 503.
SCAN_PROVIDER=none
# Gemini (Google AI Studio, plan gratuito): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Anthropic (de pago)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Solo para pruebas de integracion: base desechable cuyo nombre contenga "test" (se borra al correr npm test)
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/autocheck_test
