{
  "name": "autocheck-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts up",
    "migrate:down": "tsx --env-file-if-exists=.env src/db/migrate.ts down",
    "migrate:prod": "node dist/db/migrate.js up",
    "prebuild": "node -e \"require(\\\"node:fs\\\").rmSync(\\\"dist\\\",{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "eval:telltales": "tsx --env-file-if-exists=.env scripts/evalTelltales.ts",
    "smoke:gemini": "tsx --env-file-if-exists=.env scripts/smokeGemini.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "9.0.3",
    "morgan": "^1.10.0",
    "multer": "2.5.0",
    "node-pg-migrate": "9.0.0",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "^1.9.0",
    "@types/multer": "2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "description": "API REST de AutoCheck-CO",
  "engines": {
    "node": ">=24"
  }
}
